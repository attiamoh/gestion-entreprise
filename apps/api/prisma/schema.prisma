generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Une société du groupe. Chaque société a ses propres départements et utilisateurs.
model Company {
  id          String          @id @default(cuid())
  name        String
  legalForm   String? /// SARL, SA, SAS...
  rccm        String? /// Registre du commerce (RCCM)
  taxId       String? /// Numéro de compte contribuable (NCC)
  country     String          @default("CI")
  currency    String          @default("XOF")
  isActive    Boolean         @default(true)
  departments Department[]
  users       User[]
  roleGrants  UserRole[]
  clients     ClientAccount[]
  contacts    Contact[]
  cases       Case[]
  threads     EmailThread[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

/// Département d'une société. Peut avoir des sous-départements.
model Department {
  id        String        @id @default(cuid())
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  name      String
  code      String?
  parent    Department?   @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  parentId  String?
  children  Department[]  @relation("DepartmentTree")
  manager   User?         @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  managerId String?
  members   User[]        @relation("DepartmentMembers")
  cases     Case[]
  threads   EmailThread[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model User {
  id                 String          @id @default(cuid())
  email              String          @unique
  fullName           String
  googleSub          String?         @unique
  isActive           Boolean         @default(true)
  /// Super admin : contourne toutes les règles de permission.
  isSuperAdmin       Boolean         @default(false)
  company            Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId          String?
  department         Department?     @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  departmentId       String?
  managedDepartments Department[]    @relation("DepartmentManager")
  roles              UserRole[]
  auditLogs          AuditLog[]
  mailbox            Mailbox?
  ownedCases         Case[]
  ownedClients       ClientAccount[]
  ownedThreads       EmailThread[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([companyId])
  @@index([departmentId])
}

/// Portée d'une permission : sur quelles données elle s'applique.
enum Scope {
  OWN /// ses propres enregistrements
  DEPARTMENT /// son département et ses sous-départements
  COMPANY /// toute sa société
  ALL /// toutes les sociétés du groupe
}

/// Rôle (système ou profil personnalisé).
model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  id     String @id @default(cuid())
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId String
  module String /// ex. companies, departments, crm, hr...
  action String /// read, create, update, delete, export, approve
  scope  Scope

  @@unique([roleId, module, action])
}

/// Attribution d'un rôle à un utilisateur, éventuellement limitée à une société.
model UserRole {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId    String
  /// Société sur laquelle le rôle s'applique ; vide = société de l'utilisateur.
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String?

  @@unique([userId, roleId, companyId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId   String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

/// Entreprise cliente (ou prospect, fournisseur) suivie par une de nos sociétés.
model ClientAccount {
  id        String    @id @default(cuid())
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  name      String
  /// Domaine e-mail (ex. client.ci) pour reconnaître automatiquement les expéditeurs.
  domain    String?
  owner     User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId   String?
  contacts  Contact[]
  cases     Case[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([companyId, name])
  @@index([companyId, domain])
}

model Contact {
  id              String         @id @default(cuid())
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId       String
  clientAccount   ClientAccount? @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  clientAccountId String?
  email           String
  fullName        String?
  phone           String?
  threads         EmailThread[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([companyId, email])
}

enum CaseStatus {
  OPEN
  ON_HOLD
  CLOSED
}

/// Dossier : pivot auquel se rattachent e-mails, contrats, propositions, tâches et documents.
model Case {
  id              String         @id @default(cuid())
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId       String
  department      Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  departmentId    String?
  owner           User           @relation(fields: [ownerId], references: [id])
  ownerId         String
  clientAccount   ClientAccount? @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  clientAccountId String?
  /// Référence lisible, citée dans l'objet des e-mails (ex. D-2026-0001).
  reference       String         @unique
  title           String
  status          CaseStatus     @default(OPEN)
  threads         EmailThread[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([companyId, status])
}

/// Boîte Gmail nominative d'un utilisateur, synchronisée en continu.
model Mailbox {
  id           String         @id @default(cuid())
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String         @unique
  email        String         @unique
  /// Dernier historyId Gmail traité ; vide = synchronisation initiale à faire.
  historyId    String?
  lastSyncedAt DateTime?
  syncError    String?
  watchExpires DateTime?
  threads      EmailThread[]
  messages     EmailMessage[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

/// Fil de discussion d'une boîte. Porte la société, le département et le propriétaire pour les permissions.
model EmailThread {
  id            String         @id @default(cuid())
  mailbox       Mailbox        @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  mailboxId     String
  gmailThreadId String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId     String
  department    Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  departmentId  String?
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId       String
  subject       String
  lastMessageAt DateTime
  case          Case?          @relation(fields: [caseId], references: [id], onDelete: SetNull)
  caseId        String?
  contact       Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId     String?
  /// Comment le rattachement au dossier a été fait : reference, contact, manual.
  linkedBy      String?
  messages      EmailMessage[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([mailboxId, gmailThreadId])
  @@index([companyId, lastMessageAt])
  @@index([caseId])
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

model EmailMessage {
  id             String            @id @default(cuid())
  thread         EmailThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId       String
  mailbox        Mailbox           @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  mailboxId      String
  gmailMessageId String
  rfcMessageId   String?
  direction      EmailDirection
  fromEmail      String
  fromName       String?
  to             String[]
  cc             String[]
  subject        String
  snippet        String
  bodyText       String
  bodyHtml       String?
  labels         String[]
  sentAt         DateTime
  attachments    EmailAttachment[]
  createdAt      DateTime          @default(now())

  @@unique([mailboxId, gmailMessageId])
  @@index([threadId, sentAt])
}

model EmailAttachment {
  id                String       @id @default(cuid())
  message           EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId         String
  filename          String
  mimeType          String
  size              Int
  gmailAttachmentId String
  /// Emplacement de la copie archivée (stockage S3), une fois téléchargée.
  storageKey        String?
}
