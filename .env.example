# API
DATABASE_URL=postgresql://gestion:gestion@localhost:5432/gestion
JWT_SECRET=change-me
# Identifiant client OAuth Google (console Google Cloud > Identifiants)
GOOGLE_CLIENT_ID=
# Domaine Google Workspace autorisé (ex. monentreprise.ci) ; vide = tous
GOOGLE_ALLOWED_DOMAIN=
# Autorise POST /auth/dev-login (jamais en production)
ALLOW_DEV_LOGIN=true
PORT=3001

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
