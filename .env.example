# API
DATABASE_URL=postgresql://gestion:gestion@localhost:5432/gestion
JWT_SECRET=change-me
# Identifiant client OAuth Google (console Google Cloud > Identifiants)
GOOGLE_CLIENT_ID=
# Domaine Google Workspace autorisé (ex. monentreprise.ci) ; vide = tous
GOOGLE_ALLOWED_DOMAIN=
# Autorise POST /auth/dev-login (jamais en production)
ALLOW_DEV_LOGIN=true
PORT=3001

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Synchronisation Gmail (délégation au niveau du domaine Google Workspace)
# Clé JSON du compte de service (contenu JSON ou chemin du fichier)
GOOGLE_SERVICE_ACCOUNT=
# Sujet Pub/Sub qui reçoit les notifications push de Gmail
GMAIL_PUBSUB_TOPIC=projects/mon-projet/topics/gmail
# Jeton secret ajouté à l'URL de l'abonnement push : /emails/push?token=...
GMAIL_PUSH_TOKEN=
# Relève de secours toutes les N minutes (0 = désactivée)
EMAIL_SYNC_INTERVAL_MINUTES=5
# Profondeur de la première synchronisation, en jours
EMAIL_INITIAL_SYNC_DAYS=30
